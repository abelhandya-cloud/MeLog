<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalender & Jadwal Harian Interaktif</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Load FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s ease;
        }

        /* Animations */
        .fade-in { animation: fadeIn 0.3s ease forwards; }
        .fade-out { opacity: 0; transform: translateX(20px); transition: all 0.3s ease; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Calendar specific styles */
        .calendar-day {
            height: 48px;
            font-size: 1.15rem;
            font-weight: 800;
            transition: all 0.2s ease;
        }
        @keyframes ring-bell {
            0% { transform: rotate(0deg); }
            20% { transform: rotate(15deg); }
            40% { transform: rotate(-15deg); }
            60% { transform: rotate(10deg); }
            80% { transform: rotate(-10deg); }
            100% { transform: rotate(0deg); }
        }
        .animate-ring {
            animation: ring-bell 0.8s ease infinite;
        }
    </style>
</head>

<body id="desktop-bg" class="min-h-screen p-3 sm:p-6 bg-emerald-50/50 dark:bg-gray-950 flex flex-col items-center justify-start">
    
    <!-- Toast Alarm Notification Banner -->
    <div id="alarm-toast" class="fixed top-5 right-5 z-50 transform translate-x-[120%] transition-transform duration-300 max-w-sm w-full bg-white dark:bg-gray-800 border-l-4 border-emerald-500 shadow-2xl rounded-xl p-4 flex items-start gap-3">
        <div class="text-emerald-500 text-2xl animate-ring mt-0.5">
            <i class="fas fa-bell"></i>
        </div>
        <div class="flex-grow">
            <h4 class="font-bold text-gray-800 dark:text-white text-sm">Alarm Pengingat Waktu!</h4>
            <p id="alarm-message" class="text-xs text-gray-600 dark:text-gray-300 mt-1">Waktunya kegiatan: <span class="font-semibold">Bangun Tidur</span></p>
        </div>
        <button onclick="dismissAlarm()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Kolom Kiri: Kalender Bulanan & Menu Settings -->
        <div class="lg:col-span-5 flex flex-col gap-5">
            <!-- Kartu Kalender -->
            <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none p-5 border border-gray-100 dark:border-gray-800">
                <div class="flex justify-between items-center mb-4">
                    <h2 id="calendar-month-year" class="text-lg font-extrabold text-gray-800 dark:text-white">Bulan Tahun</h2>
                    <div class="flex items-center gap-1">
                        <button onclick="changeMonth(-1)" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg text-gray-600 dark:text-gray-300 transition-colors">
                            <i class="fas fa-chevron-left text-sm"></i>
                        </button>
                        <button onclick="goToToday()" class="px-2.5 py-1 text-xs font-semibold bg-emerald-50 text-emerald-600 dark:bg-emerald-900/40 dark:text-emerald-400 rounded-lg hover:bg-emerald-100 transition-colors">
                            Hari Ini
                        </button>
                        <button onclick="changeMonth(1)" class="p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-lg text-gray-600 dark:text-gray-300 transition-colors">
                            <i class="fas fa-chevron-right text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Hari dalam seminggu -->
                <div class="grid grid-cols-7 gap-1 text-center font-bold text-xs text-gray-400 mb-2">
                    <span>Min</span><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span>
                </div>

                <!-- Grid Tanggal -->
                <div id="calendar-grid" class="grid grid-cols-7 gap-1.5">
                    <!-- Dinamis oleh JS -->
                </div>
            </div>

            <!-- Panel Navigasi Cepat / Info Ringkas -->
            <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl shadow-gray-200/50 dark:shadow-none p-5 border border-gray-100 dark:border-gray-800 flex justify-between items-center">
                <div>
                    <h3 class="font-bold text-gray-800 dark:text-white text-sm">Status Audio & Alarm</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Bunyi pengingat otomatis aktif</p>
                </div>
                <button onclick="initAudioContext()" class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold rounded-xl text-xs shadow-md shadow-emerald-500/20 transition-all flex items-center gap-2">
                    <i class="fas fa-volume-up"></i> Aktifkan Suara
                </button>
            </div>
        </div>

        <!-- Kolom Kanan: Jadwal Harian & Catatan -->
        <div class="lg:col-span-7 flex flex-col">
            <!-- Header Kartu Jadwal -->
            <div class="bg-white dark:bg-gray-900 rounded-t-2xl shadow-xl shadow-gray-200/50 dark:shadow-none p-6 border-x border-t border-gray-100 dark:border-gray-800 flex justify-between items-center">
                <div>
                    <h1 class="text-xl sm:text-2xl font-black text-gray-800 dark:text-white tracking-tight flex items-center gap-2">
                        <i class="fas fa-calendar-check text-emerald-500"></i> <span id="selected-date-title">Memuat...</span>
                    </h1>
                    <p class="text-xs text-gray-500 mt-1">Kelola jadwal & ibadah harian Anda dengan mudah.</p>
                </div>
                
                <div class="flex items-center gap-2">
                    <!-- Tombol Setting -->
                    <button onclick="openSettings()" class="p-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors border border-gray-100 dark:border-gray-800 shadow-sm" title="Pengaturan Tema & Tampilan">
                        <i class="fas fa-cog text-lg"></i>
                    </button>
                    <!-- Dark Mode Toggle -->
                    <button id="theme-toggle" class="p-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors border border-gray-100 dark:border-gray-800 shadow-sm" aria-label="Toggle Dark Mode">
                        <i class="fas fa-moon text-lg" id="theme-icon"></i>
                    </button>
                </div>
            </div>

            <!-- Progress Bar Seksion -->
            <div class="bg-white dark:bg-gray-900 shadow-xl shadow-gray-200/50 dark:shadow-none px-6 py-4 border-x border-gray-100 dark:border-gray-800">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">Progres Kegiatan Hari Ini</span>
                    <span class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400" id="progress-text">0%</span>
                </div>
                <div class="w-full bg-gray-100 rounded-full h-2.5 dark:bg-gray-800 overflow-hidden">
                    <div class="bg-emerald-500 h-2.5 rounded-full transition-all duration-500 ease-out" id="progress-bar" style="width: 0%"></div>
                </div>
            </div>

            <!-- Tambah Jadwal Custom Form -->
            <div class="bg-white dark:bg-gray-900 shadow-xl shadow-gray-200/50 dark:shadow-none px-6 py-4 border-x border-gray-100 dark:border-gray-800">
                <form id="add-task-form" class="flex gap-2">
                    <input type="time" id="task-time" required class="px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 dark:bg-gray-800 dark:border-gray-700 dark:text-white text-sm font-mono">
                    <input type="text" id="task-text" placeholder="Tambah kegiatan harian baru..." required class="flex-grow px-4 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 dark:bg-gray-800 dark:border-gray-700 dark:text-white text-sm">
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-4 rounded-xl transition-all shadow-md shadow-emerald-600/20 flex items-center gap-1.5 text-sm">
                        <i class="fas fa-plus"></i> <span class="hidden sm:inline">Tambah</span>
                    </button>
                </form>
            </div>

            <!-- List Jadwal & Rutinitas -->
            <div class="bg-white dark:bg-gray-900 shadow-xl shadow-gray-200/50 dark:shadow-none p-6 rounded-b-2xl border border-gray-100 dark:border-gray-800 flex-grow min-h-[380px]">
                
                <!-- Filter Tabs -->
                <div class="flex justify-between items-center mb-4 border-b border-gray-100 dark:border-gray-800 pb-3">
                    <div class="flex gap-1.5">
                        <button class="filter-btn active text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-400 transition-colors" data-filter="all">Semua</button>
                        <button class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" data-filter="active">Belum</button>
                        <button class="filter-btn text-xs font-semibold px-3 py-1.5 rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" data-filter="completed">Selesai</button>
                    </div>
                    <button id="clear-completed" class="text-xs text-red-500 hover:text-red-700 font-semibold hidden transition-colors">Hapus Selesai</button>
                </div>

                <!-- Empty State -->
                <div id="empty-state" class="text-center py-8 hidden">
                    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-50 text-emerald-500 mb-3 dark:bg-gray-800">
                        <i class="fas fa-clipboard-list text-xl"></i>
                    </div>
                    <h3 class="text-sm font-bold text-gray-700 dark:text-gray-300">Belum ada jadwal kustom</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Tambahkan kegiatan Anda di atas.</p>
                </div>

                <!-- Task List -->
                <ul id="task-list" class="space-y-2.5">
                    <!-- Tasks injected by JS -->
                </ul>
                
                <!-- Ibadah & Rutinitas (Otomatis Tiap Hari) -->
                <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800">
                    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4">
                        <h3 class="text-sm font-bold text-gray-800 dark:text-white flex items-center gap-2">
                            <i class="fas fa-pray text-emerald-500"></i> Ibadah & Rutinitas Harian
                        </h3>
                        <button onclick="openRoutineModal()" class="text-xs px-3 py-1.5 bg-gray-50 hover:bg-gray-100 dark:bg-gray-800 dark:hover:bg-gray-700 rounded-lg font-medium text-gray-700 dark:text-gray-300 transition-colors shadow-sm border border-gray-200 dark:border-gray-700">
                            <i class="fas fa-edit mr-1 text-emerald-500"></i> Kelola Rutinitas
                        </button>
                    </div>
                    <p class="text-xs text-gray-400 mb-3">Muncul otomatis tiap hari. Centang saat selesai dilaksanakan.</p>
                    <ul id="routine-list" class="space-y-2">
                        <!-- Routines injected by JS -->
                    </ul>
                </div>

                <!-- Catatan Harian -->
                <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800">
                    <h3 class="text-sm font-bold text-gray-800 dark:text-white mb-2 flex items-center gap-2">
                        <i class="fas fa-sticky-note text-amber-500"></i> Catatan Hari Ini
                    </h3>
                    <textarea id="daily-notes" rows="3" placeholder="Tulis catatan penting, evaluasi, atau jurnal harian di sini..." class="w-full p-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 dark:bg-gray-800 dark:border-gray-700 dark:text-white text-xs leading-relaxed resize-none"></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Settings Modal -->
    <div id="settings-modal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 border border-gray-100 dark:border-gray-800" id="settings-content">
            <div class="flex justify-between items-center mb-5 border-b border-gray-100 dark:border-gray-800 pb-3">
                <h2 class="text-lg font-bold text-gray-800 dark:text-white flex items-center gap-2">
                    <i class="fas fa-sliders-h text-emerald-500"></i> Pengaturan Tampilan
                </h2>
                <button onclick="closeSettings()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
            
            <div class="space-y-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-2">Warna Latar Belakang Desktop (Tema Terang)</label>
                    <div class="flex items-center gap-3">
                        <input type="color" id="desktop-color-picker" value="#ecfdf5" class="w-12 h-10 rounded-xl cursor-pointer border border-gray-200 dark:border-gray-700 bg-transparent">
                        <span id="color-hex-label" class="text-xs font-mono text-gray-500">#ecfdf5</span>
                        <button onclick="resetDesktopColor()" class="ml-auto text-xs px-3 py-1.5 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg font-medium transition-colors">Reset Default</button>
                    </div>
                </div>

                <div class="pt-2">
                    <p class="text-xs text-gray-400 leading-relaxed">Pilihan warna background desktop akan langsung mengubah keseluruhan nuansa layar latar belakang halaman Anda secara otomatis.</p>
                </div>
            </div>

            <button onclick="closeSettings()" class="w-full mt-6 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-xl transition-colors text-sm shadow-md shadow-emerald-600/20">
                Simpan & Tutup
            </button>
        </div>
    </div>

    <!-- Routine Management Modal -->
    <div id="routine-modal" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-6 w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-300 border border-gray-100 dark:border-gray-800" id="routine-content">
            <div class="flex justify-between items-center mb-4 border-b border-gray-100 dark:border-gray-800 pb-3">
                <h2 class="text-lg font-bold text-gray-800 dark:text-white flex items-center gap-2">
                    <i class="fas fa-sync-alt text-emerald-500"></i> Kelola Rutinitas
                </h2>
                <button onclick="closeRoutineModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
            
            <p class="text-xs text-gray-500 mb-4">Tambahkan kegiatan yang otomatis muncul setiap hari.</p>

            <form id="add-routine-form" class="flex gap-2 mb-4">
                <input type="time" id="routine-time" required class="px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 dark:bg-gray-800 dark:border-gray-700 dark:text-white text-xs w-28 font-mono">
                <input type="text" id="routine-text" placeholder="Nama Rutinitas..." required class="flex-grow px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 dark:bg-gray-800 dark:border-gray-700 dark:text-white text-xs">
                <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white p-2.5 rounded-xl transition-colors px-4 shadow-md shadow-emerald-600/20 text-xs">
                    <i class="fas fa-plus"></i>
                </button>
            </form>

            <div class="max-h-52 overflow-y-auto pr-1 mb-4 space-y-2" style="scrollbar-width: thin;">
                <ul id="routine-manager-list" class="space-y-2">
                    <!-- Manager list injected by JS -->
                </ul>
            </div>
            
            <button onclick="closeRoutineModal()" class="w-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-800 dark:text-white font-semibold py-2.5 rounded-xl transition-colors text-xs">
                Selesai
            </button>
        </div>
    </div>

    <script>
        // --- State Management ---
        let allTasks = JSON.parse(localStorage.getItem('calendarTasksData')) || {};
        let allNotes = JSON.parse(localStorage.getItem('calendarNotesData')) || {};
        let triggeredAlarms = JSON.parse(localStorage.getItem('triggeredAlarmsData')) || {};
        
        // Master Rutinitas & Status Harian
        let masterRoutines = JSON.parse(localStorage.getItem('masterRoutinesData')) || [
            { id: 1, time: '04:30', text: 'Sholat Subuh & Doa Pagi' },
            { id: 2, time: '07:00', text: 'Sarapan & Persiapan Beraktivitas' },
            { id: 3, time: '12:00', text: 'Sholat Dzuhur & Istirahat' },
            { id: 4, time: '15:30', text: 'Sholat Ashar' },
            { id: 5, time: '18:15', text: 'Sholat Maghrib & Mengaji' },
            { id: 6, time: '19:30', text: 'Sholat Isya & Evaluasi Harian' }
        ];
        let dailyRoutineStatus = JSON.parse(localStorage.getItem('dailyRoutineStatusData')) || {};

        let customDesktopColor = localStorage.getItem('desktopColor') || '#ecfdf5';
        let isToneStarted = false;
        let currentDate = new Date();
        let selectedDate = new Date();
        let selectedDateString = formatDateKey(selectedDate);
        let currentFilter = 'all';

        // DOM References
        const calendarGrid = document.getElementById('calendar-grid');
        const calendarMonthYear = document.getElementById('calendar-month-year');
        const selectedDateTitle = document.getElementById('selected-date-title');
        const taskList = document.getElementById('task-list');
        const taskForm = document.getElementById('add-task-form');
        const taskTimeInput = document.getElementById('task-time');
        const taskTextInput = document.getElementById('task-text');
        const emptyState = document.getElementById('empty-state');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const dailyNotesInput = document.getElementById('daily-notes');
        const progressBar = document.getElementById('progress-bar');
        const progressText = document.getElementById('progress-text');
        const clearCompletedBtn = document.getElementById('clear-completed');
        
        // Modals Elements
        const routineList = document.getElementById('routine-list');
        const routineModal = document.getElementById('routine-modal');
        const routineContent = document.getElementById('routine-content');
        const routineManagerList = document.getElementById('routine-manager-list');
        const addRoutineForm = document.getElementById('add-routine-form');
        const settingsModal = document.getElementById('settings-modal');
        const settingsContent = document.getElementById('settings-content');
        const desktopColorPicker = document.getElementById('desktop-color-picker');
        const colorHexLabel = document.getElementById('color-hex-label');
        const desktopBg = document.getElementById('desktop-bg');
        
        const themeToggleBtn = document.getElementById('theme-toggle');
        const themeIcon = document.getElementById('theme-icon');
        const alarmToast = document.getElementById('alarm-toast');
        const alarmMessage = document.getElementById('alarm-message');

        // --- Helper Date Formatter ---
        function formatDateKey(dateObj) {
            const year = dateObj.getFullYear();
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const day = String(dateObj.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // --- Initialization ---
        function initApp() {
            applyDesktopTheme();
            checkTheme();
            renderCalendar();
            renderSelectedDay();
            
            // Set current time to time input
            const now = new Date();
            taskTimeInput.value = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        }

        // --- Desktop Theme Background ---
        function applyDesktopTheme() {
            if (!document.body.classList.contains('dark')) {
                desktopBg.style.backgroundColor = customDesktopColor;
                desktopColorPicker.value = customDesktopColor;
                colorHexLabel.textContent = customDesktopColor;
            } else {
                desktopBg.style.backgroundColor = '';
            }
        }

        desktopColorPicker.addEventListener('input', (e) => {
            customDesktopColor = e.target.value;
            colorHexLabel.textContent = customDesktopColor;
            localStorage.setItem('desktopColor', customDesktopColor);
            applyDesktopTheme();
        });

        window.resetDesktopColor = function() {
            customDesktopColor = '#ecfdf5';
            localStorage.setItem('desktopColor', customDesktopColor);
            applyDesktopTheme();
        }

        // --- Calendar Logic ---
        function renderCalendar() {
            calendarGrid.innerHTML = '';
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
